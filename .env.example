# Aplicação
SERVER_PORT=8080
APP_UPLOAD_PATH=uploads

# Banco de dados PostgreSQL
# Execução local:
DB_URL=jdbc:postgresql://localhost:5432/cipa
# Em Docker, use o hostname do serviço/container do PostgreSQL.
# DB_URL=jdbc:postgresql://postgres:5432/cipa
DB_USERNAME=postgres
DB_PASSWORD=

# Administrador inicial
# ADMIN_PASSWORD é usada somente quando a tabela admins estiver vazia.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=@micro123

# Mesário inicial
# MESARIO_PASSWORD é usada somente quando a tabela mesarios estiver vazia.
MESARIO_USERNAME=mesario
MESARIO_PASSWORD=@micro123

# Credencial exclusiva do tablet/cabine
# Diferentemente das contas iniciais, esta senha é lida a cada inicialização.
CABINE_USERNAME=urna
CABINE_PASSWORD=@micro123

# Regras da cabine, em segundos
# Tempo para o eleitor digitar a matrícula depois da liberação do mesário.
CABINE_LIBERACAO_SEGUNDOS=180
# Tempo para concluir o voto depois que a matrícula for identificada.
CABINE_VOTACAO_SEGUNDOS=600
# Quantidade de matrículas incorretas antes de bloquear a liberação.
CABINE_MAX_TENTATIVAS=3

# E-mail/SMTP (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_DESTINATARIO=

# Limites da importação de eleitores
IMPORTACAO_MAX_FILE_SIZE=5MB
IMPORTACAO_MAX_REQUEST_SIZE=6MB
IMPORTACAO_MAX_FILE_SIZE_BYTES=5242880
IMPORTACAO_MAX_DATA_ROWS=5000
IMPORTACAO_MAX_EXPANDED_SIZE_BYTES=52428800
IMPORTACAO_MAX_ZIP_ENTRIES=200

# Sessão HTTP
# Em produção com HTTPS, obrigatoriamente use true.
# Para desenvolvimento local somente com HTTP, use false.
SESSION_COOKIE_SECURE=false
